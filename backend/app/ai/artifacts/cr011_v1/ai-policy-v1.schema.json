{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finaudit:schema:ai-policy-v1",
  "title": "FinAudit AI Policy v1 final envelope or pre-hash payload",
  "description": "CR-011 draft machine contract. A final envelope contains policy_hash; a pre-hash payload is the same closed object with only that top-level member removed.",
  "oneOf": [
    {
      "$ref": "#/$defs/finalPolicy"
    },
    {
      "$ref": "#/$defs/preHashPayload"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,100}$"
    },
    "stableAsciiId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "canonicalHostname": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?!xn--)(?!.*\\.xn--)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"
    },
    "canonicalCidr": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]{0,2})(?:\\.(?:0|[1-9][0-9]{0,2})){3}/(?:0|[1-9]|[12][0-9]|3[0-2])$"
        },
        {
          "pattern": "^[0-9a-f:]+/(?:0|[1-9][0-9]?|1[01][0-9]|12[0-8])$"
        }
      ]
    },
    "providerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_type",
        "adapter_id",
        "endpoint_id",
        "network_scope",
        "base_url",
        "approved_hostnames",
        "allowed_cidrs",
        "address_policy_version",
        "capabilities",
        "model_id",
        "model_version",
        "allowed_response_model_ids",
        "auth_scheme",
        "secret_slot",
        "context_window_tokens",
        "tokenizer_id",
        "tokenizer_hash",
        "embedding_dimension",
        "pricing_version",
        "billing_mode",
        "input_price_micro_usd_per_million",
        "output_price_micro_usd_per_million",
        "redis_unavailable_mode"
      ],
      "properties": {
        "profile_type": {
          "enum": [
            "openai-chat-completions-v1",
            "openai-embeddings-v1"
          ]
        },
        "adapter_id": {
          "$ref": "#/$defs/stableAsciiId"
        },
        "endpoint_id": {
          "$ref": "#/$defs/stableAsciiId"
        },
        "network_scope": {
          "enum": [
            "external_public",
            "internal_service"
          ]
        },
        "base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[1-9][0-9]{0,4})?/v1$"
        },
        "approved_hostnames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonicalHostname"
          }
        },
        "allowed_cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonicalCidr"
          }
        },
        "address_policy_version": {
          "const": "ip-deny-cidrs-v1"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "embedding",
              "llm_extraction",
              "llm_generation"
            ]
          }
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_response_model_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "auth_scheme": {
          "const": "bearer"
        },
        "secret_slot": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "context_window_tokens": {
          "$ref": "#/$defs/safePositiveInteger"
        },
        "tokenizer_id": {
          "$ref": "#/$defs/stableAsciiId"
        },
        "tokenizer_hash": {
          "$ref": "#/$defs/sha256"
        },
        "embedding_dimension": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/safePositiveInteger"
            }
          ]
        },
        "pricing_version": {
          "$ref": "#/$defs/stableAsciiId"
        },
        "billing_mode": {
          "enum": [
            "external_usd",
            "internal_unmetered"
          ]
        },
        "input_price_micro_usd_per_million": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "output_price_micro_usd_per_million": {
          "$ref": "#/$defs/safeNonNegativeInteger"
        },
        "redis_unavailable_mode": {
          "enum": [
            "fail_closed",
            "process_local_restricted"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile_type": {
                "const": "openai-chat-completions-v1"
              }
            },
            "required": [
              "profile_type"
            ]
          },
          "then": {
            "properties": {
              "adapter_id": {
                "const": "openai_chat_completions_v1"
              },
              "embedding_dimension": {
                "type": "null"
              },
              "capabilities": {
                "oneOf": [
                  {
                    "const": [
                      "llm_extraction"
                    ]
                  },
                  {
                    "const": [
                      "llm_generation"
                    ]
                  },
                  {
                    "const": [
                      "llm_extraction",
                      "llm_generation"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "profile_type": {
                "const": "openai-embeddings-v1"
              }
            },
            "required": [
              "profile_type"
            ]
          },
          "then": {
            "properties": {
              "adapter_id": {
                "const": "openai_embeddings_v1"
              },
              "embedding_dimension": {
                "$ref": "#/$defs/safePositiveInteger"
              },
              "capabilities": {
                "const": [
                  "embedding"
                ]
              },
              "output_price_micro_usd_per_million": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network_scope": {
                "const": "external_public"
              }
            },
            "required": [
              "network_scope"
            ]
          },
          "then": {
            "properties": {
              "base_url": {
                "pattern": "^https://"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network_scope": {
                "const": "internal_service"
              }
            },
            "required": [
              "network_scope"
            ]
          },
          "then": {
            "properties": {
              "billing_mode": {
                "const": "internal_unmetered"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_mode": {
                "const": "internal_unmetered"
              }
            },
            "required": [
              "billing_mode"
            ]
          },
          "then": {
            "properties": {
              "input_price_micro_usd_per_million": {
                "const": 0
              },
              "output_price_micro_usd_per_million": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_mode": {
                "const": "external_usd"
              }
            },
            "required": [
              "billing_mode"
            ]
          },
          "then": {
            "properties": {
              "redis_unavailable_mode": {
                "const": "fail_closed"
              }
            }
          }
        }
      ],
      "x-finaudit-invariants": [
        "base_url hostname must already be lowercase ASCII, must not be an IP literal, and must be present in approved_hostnames; the port must be in 1..65535",
        "allowed_response_model_ids, capabilities, and approved_hostnames must already be sorted by UTF-16 code unit; allowed_cidrs must use (ip_version, unsigned_network_integer, prefix_length) order",
        "all arrays must be non-empty, unique, canonical, and already sorted; allowed_cidrs must also be semantically non-overlapping",
        "address_policy_version must identify the same registry version pinned by outbound_limits",
        "external_public allowed_cidrs must not overlap any network in the registry named by outbound_limits",
        "internal_service allowed_cidrs must be contained by private app_network_eligible registry entries and must not overlap loopback, link_local, metadata, or wildcard ranges"
      ]
    },
    "operationBaseProperties": {
      "connect_timeout_seconds": {
        "const": 5
      },
      "deadline_seconds": {
        "$ref": "#/$defs/safePositiveInteger"
      },
      "max_attempts": {
        "$ref": "#/$defs/safePositiveInteger"
      },
      "max_same_target_attempts": {
        "$ref": "#/$defs/safePositiveInteger"
      },
      "max_provider_attempts_per_business_operation": {
        "$ref": "#/$defs/safePositiveInteger"
      },
      "max_model_repairs": {
        "$ref": "#/$defs/safeNonNegativeInteger"
      },
      "max_input_tokens_per_request": {
        "$ref": "#/$defs/safeNonNegativeInteger"
      },
      "max_output_tokens_per_request": {
        "$ref": "#/$defs/safeNonNegativeInteger"
      },
      "max_total_tokens": {
        "$ref": "#/$defs/safeNonNegativeInteger"
      },
      "max_cost_micro_usd": {
        "$ref": "#/$defs/safeNonNegativeInteger"
      },
      "report_use_fallback": {
        "type": "boolean"
      },
      "primary_profile_id": {
        "$ref": "#/$defs/profileId"
      },
      "fallback_profile_id": {
        "oneOf": [
          {
            "$ref": "#/$defs/profileId"
          },
          {
            "type": "null"
          }
        ]
      }
    },
