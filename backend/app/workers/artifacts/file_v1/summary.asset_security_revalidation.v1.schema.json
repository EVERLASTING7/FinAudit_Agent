{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_security_revalidation.summary.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_parse_version_id",
    "page_count",
    "block_count",
    "asset_count",
    "clean_count",
    "non_clean_count",
    "status"
  ],
  "properties": {
    "result_parse_version_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "page_count": {"type": "integer", "minimum": 1, "maximum": 2000},
    "block_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "asset_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "clean_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "non_clean_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "status": {"enum": ["succeeded", "manual_review_required"]}
  }
}
