{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finaudit:worker:summary:invoice-extract:v1",
  "type": "object",
  "required": ["invoice_id", "field_count", "item_count", "duplicate_status"],
  "properties": {
    "invoice_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "field_count": {"type": "integer", "minimum": 0, "maximum": 12},
    "item_count": {"type": "integer", "minimum": 0, "maximum": 1000},
    "duplicate_status": {"enum": ["not_checked", "unique", "suspected"]}
  },
  "additionalProperties": false
}
