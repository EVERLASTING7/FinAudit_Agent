{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finaudit:worker:summary:audit-execute:v1",
  "type": "object",
  "required": ["execution_id", "rule_count", "risk_count", "overall_level", "retrieval_status"],
  "properties": {
    "execution_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "rule_count": {"const": 15},
    "risk_count": {"type": "integer", "minimum": 0, "maximum": 15},
    "overall_level": {"enum": ["none", "notice", "low", "medium", "high"]},
    "retrieval_status": {"enum": ["not_required", "succeeded", "degraded"]}
  },
  "additionalProperties": false
}
