{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finaudit:worker:summary:report-generate:v1",
  "type": "object",
  "required": [
    "report_id",
    "pdf_sha256",
    "pdf_size_bytes",
    "xlsx_sha256",
    "xlsx_size_bytes"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pdf_size_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
    "xlsx_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "xlsx_size_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152}
  },
  "additionalProperties": false
}
