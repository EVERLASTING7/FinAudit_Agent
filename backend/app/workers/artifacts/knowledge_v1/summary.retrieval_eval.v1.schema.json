{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finaudit:worker:summary:retrieval-eval:v1",
  "type": "object",
  "required": ["run_id", "case_count", "passed"],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "case_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "passed": {"type": "boolean"}
  },
  "additionalProperties": false
}
