{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finaudit:worker:summary:knowledge-index-build:v1",
  "type": "object",
  "required": ["index_version_id", "member_count", "manifest_sha256"],
  "properties": {
    "index_version_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "member_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
