# 本机从源码直接运行 Backend/Worker 时，默认读取同目录 .env。
# 进程环境变量和运行时 Secret 优先于 .env；Docker 镜像不会包含该文件。
# 本文件仅提供变量名和安全占位符；不得提交真实 .env 或任何真实凭据。

# General
APP_NAME=FinAudit Agent
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
TIMEZONE=UTC
SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
JWT_REFRESH_REMEMBER_EXPIRE_DAYS=30
# Ed25519 私钥只通过运行时 Secret mount 提供；公钥 keyring 为 {kid: PEM} JSON。
AUTH_JWT_ACTIVE_KID=REPLACE_WITH_8_TO_64_CHAR_KEY_ID
AUTH_JWT_PRIVATE_KEY_FILE=/run/secrets/finaudit_auth_ed25519_private.pem
AUTH_JWT_PUBLIC_KEYRING_FILE=/app/config/finaudit_auth_ed25519_public_keyring.json
AUTH_PUBLIC_ORIGIN=REPLACE_WITH_HTTPS_ORIGIN_WITHOUT_PATH

# 完整 local Compose 启动器生成这些非机密值；不要手工把 Secret 写进 compose.env。
FINAUDIT_RUNTIME_DIR=REPLACE_WITH_ABSOLUTE_PATH_OUTSIDE_REPOSITORY
FINAUDIT_HTTPS_PORT=8443
FINAUDIT_IMAGE_REVISION=dev
BOOTSTRAP_ORGANIZATION_NAME=REPLACE_WITH_LOCAL_ORGANIZATION_NAME
BOOTSTRAP_ORGANIZATION_USCC=REPLACE_WITH_18_CHARACTER_USCC
BOOTSTRAP_ORGANIZATION_TAX_NUMBER=REPLACE_WITH_TAX_NUMBER
BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_LOCAL_ADMIN_USERNAME
BOOTSTRAP_ADMIN_DISPLAY_NAME=REPLACE_WITH_LOCAL_ADMIN_DISPLAY_NAME

# HTTP
HTTP_PORT=80
HTTPS_PORT=443
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost
MAX_UPLOAD_SIZE_MB=50
MAX_BATCH_FILE_COUNT=20

# PostgreSQL
POSTGRES_IMAGE_TAG=16-alpine
POSTGRES_IMAGE_DIGEST=sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=finaudit
POSTGRES_USER=finaudit
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://finaudit:CHANGE_ME@postgresql:5432/finaudit
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis / Celery
REDIS_IMAGE_TAG=7.4.9-alpine
REDIS_IMAGE_DIGEST=sha256:6ab0b6e7381779332f97b8ca76193e45b0756f38d4c0dcda72dbb3c32061ab99
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@redis:6379/1
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1700
CELERY_QUEUE_DOCUMENT=document
CELERY_QUEUE_EXTRACTION=extraction
CELERY_QUEUE_KNOWLEDGE=knowledge
CELERY_QUEUE_EVALUATION=evaluation
CELERY_QUEUE_AUDIT=audit
CELERY_QUEUE_REPORT=report
CELERY_QUEUE_MAINTENANCE=maintenance

# MinIO
# local-minio-v1 非机密镜像 pin；Compose 必须组合为 minio/minio:${MINIO_IMAGE_TAG}@${MINIO_IMAGE_DIGEST}。
MINIO_IMAGE_TAG=RELEASE.2025-09-07T16-13-09Z
MINIO_IMAGE_DIGEST=sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
# Worker 独立身份：仅读/删 quarantine，仅读/写/补偿删 originals。
MINIO_WORKER_ACCESS_KEY=CHANGE_ME
MINIO_WORKER_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false
MINIO_BUCKET_QUARANTINE=quarantine
MINIO_BUCKET_ORIGINALS=originals
MINIO_BUCKET_ASSETS=assets
MINIO_BUCKET_PREVIEWS=previews
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_EXPORTS=exports
MINIO_BUCKET_TEMP=temp
SIGNED_URL_EXPIRE_SECONDS=300

# Qdrant：local Profile 暂固定已验证的 1.10 数据卷格式；跨版本升级必须显式迁移或重建派生索引。
QDRANT_IMAGE_TAG=v1.10.0
QDRANT_IMAGE_DIGEST=sha256:2e8646f963a64a21b3e3f851719e17668644d1ed386285064c2548a52d16ede8
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# GAP-008 关闭前不得固化冲突中的 Collection 粒度与命名。
QDRANT_COLLECTION=REPLACE_AFTER_CR_GAP_008
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine

# AI contract gate: contract/offline is the only approved environment scope
AI_POLICY_VERSION=1
AI_PROVIDER_CALLS_ENABLED=false
AI_PROVIDER_POLICY_SCHEMA_VERSION=1
AI_POLICY_FILE=/app/config/ai-policy-v1.json

# LLM / vLLM Profile candidates; placeholders are not approved environment values
LLM_BASE_URL=REPLACE_APPROVED_VERSION_ROOT
LLM_API_KEY=CHANGE_ME
LLM_EXTRACTION_MODEL=MiniMax-M3
LLM_GENERATION_MODEL=MiniMax-M3
LLM_FALLBACK_MODEL=REPLACE_DISTINCT_FALLBACK_MODEL
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_ATTEMPTS_PER_GENERATION=3
LLM_MAX_SAME_TARGET_ATTEMPTS=2
AI_MAX_PROVIDER_ATTEMPTS_PER_OPERATION=6
AI_MAX_MODEL_REPAIRS=2
LLM_REPORT_DRAFT_USE_FALLBACK=false

# Per-operation hard deadlines
AI_CONTRACT_EXTRACTION_DEADLINE_SECONDS=120
AI_INVOICE_EXTRACTION_DEADLINE_SECONDS=60
AI_RISK_EXPLANATION_DEADLINE_SECONDS=60
AI_RAG_ANSWER_DEADLINE_SECONDS=90
AI_REPORT_DRAFT_DEADLINE_SECONDS=90
AI_EMBEDDING_DEADLINE_SECONDS=30

# Retry and breaker
AI_RETRY_BACKOFF_BASE_SECONDS=1
AI_RETRY_BACKOFF_MULTIPLIER=2
AI_RETRY_BACKOFF_MAX_SECONDS=30
AI_RETRY_JITTER_RATIO=0.2
AI_BREAKER_FAILURES=5
AI_BREAKER_WINDOW_SECONDS=60
AI_BREAKER_OPEN_SECONDS=30
AI_BREAKER_HALF_OPEN_PROBES=1

# Per-target rate-limit pools: concurrency/RPM/TPM/burst
AI_RAG_LIMITS=2/12/100000/2
AI_ASYNC_GENERATION_LIMITS=4/30/250000/4
AI_EMBEDDING_LIMITS=2/30/500000/2

# Outbound byte limits
AI_MAX_REQUEST_BYTES=4194304
AI_MAX_RESPONSE_HEADER_BYTES=65536
AI_MAX_CHAT_DECOMPRESSED_BYTES=2097152
AI_MAX_EMBEDDING_DECOMPRESSED_BYTES=4194304

# 已确认缺口：部署文档 vLLM Compose Profile 已使用以下变量，但 5.2 清单遗漏。
# 保持为空；启用 ENABLE_LOCAL_VLLM 前必须按实际硬件验证并填写。
VLLM_IMAGE_TAG=
VLLM_MODEL_PATH_OR_ID=
VLLM_MAX_MODEL_LEN=

# Embedding：当前 MiniMax-M3 live Profile 未批准真实 Embedding Provider。
# 启用 AI_PROVIDER_CALLS_ENABLED 时，这三项必须保持下列确定性索引配置，避免把 Hash 向量误标为真实模型输出。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=deterministic-hash-v1
EMBEDDING_VECTOR_SIZE=1024
EMBEDDING_BATCH_SIZE=32

# OCR
OCR_PROVIDER=not_configured
OCR_BASE_URL=
OCR_API_KEY=
OCR_TESSERACT_EXECUTABLE=
OCR_TESSERACT_VERSION=
OCR_PDFTOPPM_EXECUTABLE=
OCR_LANGUAGES=chi_sim+eng
OCR_REQUEST_TIMEOUT_SECONDS=120
OCR_MAX_RETRIES=1

# Malware Scanner：完整 local Compose 使用下列固定 ClamAV；production 仍须独立批准网络、更新、审计和容量 Profile。
CLAMAV_IMAGE_TAG=1.5.3
CLAMAV_IMAGE_DIGEST=sha256:d06c1d6a451d616e1dd79b42f44c8c8c291bba9cf4e75ebc4d0e43c1c6dd87bb
SCANNER_PROVIDER=not_configured
SCANNER_HOST=
SCANNER_PORT=3310
SCANNER_CONNECT_TIMEOUT_SECONDS=5
SCANNER_READ_TIMEOUT_SECONDS=120
SCANNER_MAX_STREAM_BYTES=52428800

# Nginx local TLS 网关镜像；生产证书、域名和 TLS Policy 不复用本地自签名 Profile。
NGINX_IMAGE_TAG=1.30.4-alpine
NGINX_IMAGE_DIGEST=sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46
NGINX_CLIENT_MAX_BODY_SIZE=50m
NGINX_RATE_LIMIT_API=20r/s

# AI/RAG defaults - must be validated by fixed datasets
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=
RAG_MAX_CONTEXT_CHUNKS=5

# Metrics
METRICS_ENABLED=true
METRICS_INTERNAL_TOKEN=CHANGE_ME

# Feature flags
ENABLE_LOCAL_VLLM=false
ENABLE_NEO4J=false
ENABLE_LANGFUSE=false
ENABLE_PROMETHEUS_STACK=false
