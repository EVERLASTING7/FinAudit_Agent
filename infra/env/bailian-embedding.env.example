# 阿里云百炼纯文本 Embedding 候选覆盖模板（华北 2，北京）
#
# 状态：TEMPLATE_ONLY。当前活跃 AI Policy 仍不允许真实 Embedding；本文件不会被自动加载。
# 默认使用百炼中国大陆版 OpenAI 兼容地址；生产环境可再切换到业务空间专属域名。
# API Key 只通过运行时 Secret `embedding_api_key` / `FINAUDIT_SECRETS_DIR`
# 注入，不得写入本文件。
# 在匹配的 AI Policy 获批并通过 fixed-test 前，不得启用 AI_PROVIDER_CALLS_ENABLED。

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_VECTOR_SIZE=1024
EMBEDDING_BATCH_SIZE=20

# Qdrant Collection 的向量维度必须与模型输出维度一致。
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine

# 兼容备选：text-embedding-v4（默认同为 1024 维，但批次大小必须降至不超过 10）。
