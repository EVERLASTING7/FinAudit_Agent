# CR-021：MiniMax Chat + 阿里云百炼 Embedding 本地/测试覆盖模板
#
# 状态：APPROVED_LOCAL_TEST_OVERLAY。本文件不会自动加载，也不授权 production。
# 启用后，Chat 与 Embedding 都可能产生真实费用；API Key 只通过运行时 Secret
# `llm_api_key`、`embedding_api_key` / `FINAUDIT_SECRETS_DIR` 注入，不得写入本文件。

AI_PROVIDER_CALLS_ENABLED=true
AI_POLICY_FILE=/app/config/live-ai-policy-v2.json

LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_EXTRACTION_MODEL=MiniMax-M3
LLM_GENERATION_MODEL=MiniMax-M3
LLM_FALLBACK_MODEL=MiniMax-M3

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_VECTOR_SIZE=1024
EMBEDDING_BATCH_SIZE=20

# 真实模型索引必须使用新 Collection/索引版本，不得复用或原地覆盖 Hash 索引。
QDRANT_COLLECTION=finaudit_policy_chunks_local_qwen37_e1024_v1
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine
