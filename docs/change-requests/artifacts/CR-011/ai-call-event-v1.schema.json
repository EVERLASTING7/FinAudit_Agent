  "$id": "urn:finaudit:schema:ai-call-event-v1",
  "title": "FinAudit AiCallEventV1",
  "description": "Closed discriminated union for sequence-1 started reservations, sequence-2 authoritative completions, and sequence-3 late-completion evidence. Source parsing rejects duplicate object keys before validation.",
