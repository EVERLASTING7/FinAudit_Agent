{
  "artifact_version": 1,
  "base_vector": "ai-policy-v1.positive.json",
  "base_policy_hash": "db946ad109baf5ec84455a2d0a09ce5e29602c0d9f9ce8404901f5c63683443d",
  "description": "Deterministic mutations applied independently to the positive Policy. Every case must fail closed at the declared stage.",
  "harness_semantics": {
    "mutation_base": "fresh deep copy of base_vector for every case",
    "path_syntax": "RFC 6901 JSON Pointer",
    "hash_refresh_by_expected_stage": {
      "cross_field": true,
      "network_registry": true,
      "default": false
    },
    "result_contract": "exactly one rejected result whose stage equals expected_stage and whose safe error identifies the first failing rule"
  },
  "cases": [
    {
      "id": "NEG-POL-001-missing-hash",
      "mutation": {
        "op": "remove",
        "path": "/policy_hash"
      },
      "validation_target": "final_envelope",
      "expected_stage": "envelope_context",
      "expected_rule_id": "POL-VAL-003",
      "expected_safe_error_code": "AI_POLICY_ENVELOPE_INVALID",
      "expected_reason": "The union accepts this shape only as a pre-hash payload; a final-envelope loader requires policy_hash."
    },
    {
      "id": "NEG-POL-001a-empty-hash",
      "mutation": {
        "op": "replace",
        "path": "/policy_hash",
        "value": ""
      },
      "expected_stage": "schema",
      "expected_rule_id": "POL-VAL-004",
      "expected_safe_error_code": "AI_POLICY_SCHEMA_INVALID",
      "expected_reason": "An empty string is not a lowercase SHA-256 digest."
    },
    {
      "id": "NEG-POL-001b-self-referential-preimage",
      "mutation": {
        "op": "replace",
        "path": "/policy_hash",
        "value": "ffdf11ddaeebc86954cf8677443c3ef0814fc2c19dfaadfbf98f1871a9a2e026"
      },
      "hash_projection": {
        "incorrectly_retained_path": "/policy_hash",
        "incorrect_digest_sha256": "ffdf11ddaeebc86954cf8677443c3ef0814fc2c19dfaadfbf98f1871a9a2e026"
      },
      "expected_stage": "hash",
      "expected_rule_id": "POL-VAL-006",
      "expected_safe_error_code": "AI_POLICY_HASH_MISMATCH",
      "expected_reason": "The pre-hash projection removes exactly the top-level policy_hash; hashing the final envelope is self-referential and cannot verify."
    },
    {
      "id": "NEG-POL-002-uppercase-hash",
      "mutation": {
        "op": "replace",
        "path": "/policy_hash",
        "value": "DB946AD109BAF5EC84455A2D0A09CE5E29602C0D9F9CE8404901F5C63683443D"
      },
      "expected_stage": "schema",
      "expected_rule_id": "POL-VAL-004",
      "expected_safe_error_code": "AI_POLICY_SCHEMA_INVALID",
      "expected_reason": "Hash text must be exactly 64 lowercase hexadecimal characters."
    },
    {
      "id": "NEG-POL-003-tampered-content",
      "mutation": {
        "op": "replace",
        "path": "/profiles/llm_extraction_primary/model_version",
        "value": "synthetic-extraction-v2"
      },
      "expected_stage": "hash",
      "expected_rule_id": "POL-VAL-006",
      "expected_safe_error_code": "AI_POLICY_HASH_MISMATCH",
      "expected_reason": "This one-byte schema-valid content change leaves a stale policy_hash and must fail only at hash verification."
    },
    {
      "id": "NEG-POL-004-boolean-integer",
      "mutation": {
        "op": "replace",
        "path": "/policy_version",
        "value": true
      },
      "expected_stage": "source_number",
      "expected_rule_id": "POL-VAL-002",
      "expected_safe_error_code": "AI_POLICY_INTEGER_TOKEN_INVALID",
      "expected_reason": "JSON boolean is not an integer in this contract."
    },
    {
      "id": "NEG-POL-005-unknown-field",
      "mutation": {
        "op": "add",
        "path": "/debug_mode",
        "value": true
      },
      "expected_stage": "schema",
      "expected_rule_id": "POL-VAL-004",
      "expected_safe_error_code": "AI_POLICY_SCHEMA_INVALID",
      "expected_reason": "The Policy object is closed."
    },
    {
      "id": "NEG-POL-005a-lexical-one-point-zero",
      "source_mutation": {
        "path": "/policy_version",
        "replacement_json_token": "1.0"
      },
      "expected_stage": "source_number",
      "expected_rule_id": "POL-VAL-002",
      "expected_safe_error_code": "AI_POLICY_INTEGER_TOKEN_INVALID",
      "expected_reason": "Policy integer tokens cannot contain a decimal point even when a generic JSON Schema implementation considers the value mathematical integer."
    },
    {
      "id": "NEG-POL-005b-lexical-one-exponent-zero",
      "source_mutation": {
        "path": "/policy_version",
        "replacement_json_token": "1e0"
      },
      "expected_stage": "source_number",
      "expected_rule_id": "POL-VAL-002",
      "expected_safe_error_code": "AI_POLICY_INTEGER_TOKEN_INVALID",
      "expected_reason": "Policy integer tokens cannot use exponent notation."
    },
    {
      "id": "NEG-POL-005c-lexical-negative-zero",
      "source_mutation": {
        "path": "/profiles/embedding_primary/input_price_micro_usd_per_million",
        "replacement_json_token": "-0"
      },
      "expected_stage": "source_number",
      "expected_rule_id": "POL-VAL-002",
      "expected_safe_error_code": "AI_POLICY_INTEGER_TOKEN_INVALID",
      "expected_reason": "A non-negative Policy integer token cannot use a sign, including negative zero."
    },
    {
      "id": "NEG-POL-005d-over-safe-integer",
      "mutation": {
        "op": "replace",
        "path": "/profiles/embedding_primary/context_window_tokens",
        "value": 9007199254740992
      },
      "expected_stage": "source_number",
      "expected_rule_id": "POL-VAL-002",
      "expected_safe_error_code": "AI_POLICY_INTEGER_TOKEN_INVALID",
      "expected_reason": "Every Policy integer is bounded by the I-JSON safe integer maximum 9007199254740991."
    },
    {
      "id": "NEG-POL-006-forbidden-secret-value-field",
      "mutation": {
        "op": "add",
        "path": "/profiles/llm_extraction_primary/api_key",
        "value": "<forbidden-secret-value-field>"
      },
      "expected_stage": "schema",
      "expected_rule_id": "POL-VAL-004",
      "expected_safe_error_code": "AI_POLICY_SCHEMA_INVALID",
      "expected_reason": "Profiles reference a secret_slot identifier and never contain credential values."
    },
    {
      "id": "NEG-POL-007-dangling-primary-profile",
      "mutation": {
        "op": "replace",
        "path": "/operations/contract_field_extraction/primary_profile_id",
