        },
        {
          "op": "replace",
          "path": "/profiles/unused_profile/model_id",
          "value": "synthetic-unused-model"
        }
      ],
      "expected_stage": "cross_field",
      "expected_rule_id": "POL-VAL-008",
      "expected_safe_error_code": "AI_POLICY_ROUTE_GRAPH_INVALID",
      "expected_reason": "Every declared Profile must be referenced by at least one operation."
    },
    {
      "id": "NEG-POL-010-duplicate-target-identity",
      "mutations": [
        {
          "op": "replace",
          "path": "/profiles/llm_fallback/endpoint_id",
          "value": "synthetic-internal-extraction-001"
        },
        {
          "op": "replace",
          "path": "/profiles/llm_fallback/model_id",
          "value": "synthetic-extraction-model"
        }
      ],
      "expected_stage": "cross_field",
      "expected_rule_id": "POL-VAL-008",
      "expected_safe_error_code": "AI_POLICY_ROUTE_GRAPH_INVALID",
      "expected_reason": "adapter_id, endpoint_id, and model_id must be unique as a tuple."
    },
    {
      "id": "NEG-POL-011-external-http",
      "mutations": [
        {
          "op": "replace",
          "path": "/profiles/llm_extraction_primary/network_scope",
          "value": "external_public"
        },
        {
          "op": "replace",
          "path": "/profiles/llm_extraction_primary/billing_mode",
          "value": "external_usd"
        }
      ],
      "expected_stage": "schema",
      "expected_rule_id": "POL-VAL-004",
      "expected_safe_error_code": "AI_POLICY_SCHEMA_INVALID",
      "expected_reason": "An external Profile requires an https base_url and metered fail-closed budget semantics."
    },
    {
      "id": "NEG-POL-012-hostname-mismatch",
      "mutation": {
        "op": "replace",
        "path": "/profiles/llm_extraction_primary/approved_hostnames/0",
        "value": "different-synthetic-host"
      },
      "expected_stage": "cross_field",
      "expected_rule_id": "POL-VAL-009",
      "expected_safe_error_code": "AI_POLICY_HOST_INVALID",
      "expected_reason": "base_url hostname must equal an approved normalized hostname."
    },
    {
      "id": "NEG-POL-013-noncanonical-cidr",
      "mutation": {
        "op": "replace",
        "path": "/profiles/llm_extraction_primary/allowed_cidrs/0",
        "value": "10.250.1.7/24"
      },
      "expected_stage": "network_registry",
      "expected_rule_id": "POL-VAL-010",
      "expected_safe_error_code": "AI_POLICY_CIDR_NOT_CANONICAL",
      "expected_reason": "CIDRs must use masked canonical network form."
    },
    {
      "id": "NEG-POL-014-denied-cidr-overlap",
      "mutation": {
        "op": "replace",
        "path": "/profiles/llm_extraction_primary/allowed_cidrs/0",
