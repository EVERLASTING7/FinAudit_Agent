      "expected_rule_id": "POL-VAL-008",
      "expected_safe_error_code": "AI_POLICY_ROUTE_GRAPH_INVALID",
      "expected_reason": "Every route reference must resolve to an existing Profile."
    },
    {
      "id": "NEG-POL-008-capability-mismatch",
      "mutation": {
        "op": "replace",
        "path": "/operations/contract_field_extraction/primary_profile_id",
        "value": "embedding_primary"
      },
      "expected_stage": "cross_field",
      "expected_rule_id": "POL-VAL-008",
      "expected_safe_error_code": "AI_POLICY_ROUTE_GRAPH_INVALID",
      "expected_reason": "Extraction routes require the llm_extraction capability."
    },
    {
      "id": "NEG-POL-009-unreferenced-profile",
      "mutations": [
        {
          "op": "add",
          "path": "/profiles/unused_profile",
          "value_from": "/profiles/llm_extraction_primary"
        },
        {
          "op": "replace",
          "path": "/profiles/unused_profile/endpoint_id",
