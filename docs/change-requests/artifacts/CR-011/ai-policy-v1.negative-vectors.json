      },
      "expected_stage": "network_registry",
      "expected_rule_id": "POL-VAL-011",
      "expected_safe_error_code": "AI_POLICY_NETWORK_SCOPE_INVALID",
      "expected_reason": "An allowed range must not overlap any versioned deny range."
    },
    {
      "id": "NEG-POL-015-unsorted-array",
      "mutation": {
        "op": "replace",
        "path": "/profiles/llm_fallback/approved_hostnames",
