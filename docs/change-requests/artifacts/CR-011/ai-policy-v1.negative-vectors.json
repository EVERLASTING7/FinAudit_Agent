          "synthetic-fallback",
          "aaa-synthetic-host"
        ]
      },
      "expected_stage": "cross_field",
      "expected_rule_id": "POL-VAL-007",
      "expected_safe_error_code": "AI_POLICY_ARRAY_NOT_CANONICAL",
