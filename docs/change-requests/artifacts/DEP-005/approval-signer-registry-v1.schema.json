{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approval-signer-registry-v1.schema.json",
  "title": "Approval Signer Registry V1 Schema",
  "description": "Schema for an approval signer registry. Schema validation alone does not establish registry trust or approval authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "keys"
  ],
  "properties": {
    "schema_version": {
      "const": "approval-signer-registry-v1"
    },
    "registry_version": {
      "$ref": "#/$defs/version"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/signerKey"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "opaqueName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "nullableUtcTimestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/utcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "approverRole": {
      "type": "string",
      "enum": [
        "requirements_product",
        "architecture",
        "data_dba",
        "backend_api",
        "frontend_ui",
        "ai_rag",
        "ops",
        "security",
        "test"
      ]
    },
    "individualEvidenceScope": {
      "type": "string",
      "enum": [
        "source_contract_approver_decision",
        "joint_approver_decision",
        "cr004_artifact_approver_decision",
        "cr010_contract_approver_decision",
        "provider_environment_approver_decision",
        "request_sync_authorization_decision"
      ]
    },
    "ed25519PublicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "p256PublicKey": {
      "type": "string",
      "pattern": "^B[A-P][A-Za-z0-9_-]{84}[AEIMQUYcgkosw048]$"
    },
    "signerKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "approver_id",
        "algorithm",
        "public_key_encoding",
        "public_key",
        "allowed_roles",
        "allowed_scopes",
        "valid_from",
        "valid_until",
        "revoked_at"
      ],
      "properties": {
        "key_id": {
          "$ref": "#/$defs/opaqueName"
        },
        "approver_id": {
          "$ref": "#/$defs/uuid"
        },
        "algorithm": {
          "enum": [
            "ed25519",
            "ecdsa_p256_sha256"
          ]
        },
        "public_key_encoding": {
          "enum": [
            "raw_32_bytes_base64url",
            "sec1_uncompressed_65_bytes_base64url"
          ]
        },
        "public_key": {
          "type": "string"
        },
        "allowed_roles": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/approverRole"
          }
        },
        "allowed_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 7,
          "items": {
            "type": "string",
            "enum": [
              "source_contract_approver_decision",
              "joint_approver_decision",
              "joint_aggregate",
              "cr004_artifact_approver_decision",
              "cr010_contract_approver_decision",
              "provider_environment_approver_decision",
              "request_sync_authorization_decision"
            ]
          }
        },
        "valid_from": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "valid_until": {
          "$ref": "#/$defs/nullableUtcTimestamp"
        },
        "revoked_at": {
          "$ref": "#/$defs/nullableUtcTimestamp"
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "algorithm": {
                  "const": "ed25519"
                },
                "public_key_encoding": {
                  "const": "raw_32_bytes_base64url"
                },
                "public_key": {
                  "$ref": "#/$defs/ed25519PublicKey"
                }
              }
            },
            {
              "properties": {
                "algorithm": {
                  "const": "ecdsa_p256_sha256"
                },
                "public_key_encoding": {
                  "const": "sec1_uncompressed_65_bytes_base64url"
                },
                "public_key": {
                  "$ref": "#/$defs/p256PublicKey"
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "allowed_roles": {
                  "type": "array",
                  "maxItems": 0
                },
                "allowed_scopes": {
                  "const": [
                    "joint_aggregate"
                  ]
                }
              }
            },
            {
              "properties": {
                "allowed_roles": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 9
                },
                "allowed_scopes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/individualEvidenceScope"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
